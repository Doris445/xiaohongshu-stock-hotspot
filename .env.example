# auto | codex | claude | openai-compatible | local-keywords
SENTIBOARD_LLM_PROVIDER=auto

# DeepSeek or another OpenAI-compatible API. Never commit real values.
SENTIBOARD_LLM_API_BASE=https://api.deepseek.com
SENTIBOARD_LLM_MODEL=deepseek-chat
SENTIBOARD_LLM_API_KEY=

# Required before binding the server to a non-loopback address.
SENTIBOARD_REFRESH_TOKEN=

# 东方财富公开页面采用串行访问。命中每股 50 页安全上限时会明确标记为“部分”，不会伪装成全量。
SENTIBOARD_GUBA_REQUEST_DELAY=0.8
SENTIBOARD_GUBA_MAX_PAGES_PER_STOCK=50
SENTIBOARD_GUBA_DETAIL_CANDIDATES=24

# 项目专属东方财富隔离浏览器。通常无需修改；端口只监听本机。
SENTIBOARD_EASTMONEY_CDP_PORT=9333
SENTIBOARD_CHROME_PATH=
